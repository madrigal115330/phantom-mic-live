@@ -0,0 +1,75 @@
+# B4A receiver (com.reiceve.voice)
+
+The helper exposes this read-only stream:
+
+    content://com.sara.voicecapturehelper.recorder/far-party-pcm
+
+Only the installed package named com.reiceve.voice is accepted. The stream is raw PCM16
+little-endian, mono, 48,000 Hz. It has no WAV header. Reads may return any byte count, so enqueue
+exactly Length bytes from each event; do not assume Android preserves the helper's 1,920-byte writes.
+
+Add the JavaObject and RandomAccessFile libraries, then use:
+
+Add this provider visibility entry to the B4A manifest:
+
+~~~basic
+AddManifestText(
+<queries>
+    <provider android:authorities="com.sara.voicecapturehelper.recorder" />
+</queries>
+)
+~~~
+
+~~~basic
+Sub Process_Globals
+    Private PcmAStream As AsyncStreams
+    Private PcmPfd As JavaObject
+End Sub
+
+Sub StartFarPartyPcm
+    Dim ctxt As JavaObject
+    ctxt.InitializeContext
+    Dim resolver As JavaObject = ctxt.RunMethod("getContentResolver", Null)
+
+    Dim uriClass As JavaObject
+    uriClass.InitializeStatic("android.net.Uri")
+    Dim uri As Object = uriClass.RunMethod("parse", Array( _
+        "content://com.sara.voicecapturehelper.recorder/far-party-pcm"))
+
+    PcmPfd = resolver.RunMethod("openFileDescriptor", Array(uri, "r"))
+    Dim fd As Object = PcmPfd.RunMethod("getFileDescriptor", Null)
+
+    Dim input As JavaObject
+    input.InitializeNewInstance("java.io.FileInputStream", Array(fd))
+    PcmAStream.Initialize(input, Null, "Pcm")
+End Sub
+
+Sub Pcm_NewData(Buffer() As Byte)
+    ' Buffer contains raw far-party PCM. Copy/enqueue it immediately for VAD/STT.
+    ' SttQueue.Add(Buffer)
+End Sub
+
+Sub Pcm_Error
+    Log("PCM stream error")
+    StopFarPartyPcm
+End Sub
+
+Sub Pcm_Terminated
+    Log("PCM stream closed")
+    StopFarPartyPcm
+End Sub
+
+Sub StopFarPartyPcm
+    If PcmAStream.IsInitialized Then PcmAStream.Close
+    If PcmPfd.IsInitialized Then PcmPfd.RunMethod("close", Null)
+End Sub
+~~~
+
+Call StartFarPartyPcm only after the WhatsApp call is answered. Closing PcmPfd makes the helper's
+pipe fail and the privileged capture session cleans itself up.
+
+The helper must have completed its Wireless Debugging pairing and its persistent daemon must be
+running before the call starts. The helper arms the VoIP playback policy every time that daemon
+connects.
+
+No storage permission is used by either side.
