index 0000000..096d2cf
--- /dev/null
+++ b/app/src/main/java/com/baba/callvault/server/FarPartyPcmSession.kt
@@ -0,0 +1,95 @@
+/*
+ * Voice Capture Helper: far-party PCM bridge derived from CallVault.
+ * GPL-3.0-or-later; see LICENSE at the project root.
+ */
+package com.baba.callvault.server
+
+import android.media.AudioRecord
+import android.os.ParcelFileDescriptor
+import android.os.Process
+import com.baba.callvault.utils.AppLogger
+import java.io.FileOutputStream
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** Streams only the remote VoIP party as raw PCM16 mono 48 kHz into a pipe. */
+internal class FarPartyPcmSession(
+    private val outFd: ParcelFileDescriptor,
+    private val onEnded: (FarPartyPcmSession) -> Unit,
+) : RecordingSession {
+    private val stopRequested = AtomicBoolean(false)
+    @Volatile private var record: AudioRecord? = null
+    @Volatile private var output: FileOutputStream? = null
+    @Volatile private var thread: Thread? = null
+
+    override fun start() {
+        check(VoipAudioPolicy.isArmed) { "VoIP policy must be armed before the call" }
+        val sink = VoipAudioPolicy.createSink()
+            ?: error("Could not create far-party AudioRecord sink")
+        val stream = FileOutputStream(outFd.fileDescriptor)
+        record = sink
+        output = stream
+
+        try {
+            sink.startRecording()
+            check(sink.recordingState == AudioRecord.RECORDSTATE_RECORDING) {
+                "Far-party AudioRecord did not enter RECORDING state"
+            }
+            thread = Thread({ pump(sink, stream) }, "far-party-pcm-pipe").apply {
+                isDaemon = true
+                start()
+            }
+            AppLogger.i(TAG, "Far-party PCM stream started: 48000 Hz, mono, PCM16LE")
+        } catch (t: Throwable) {
+            closeResources()
+            throw t
+        }
+    }
+
+    private fun pump(sink: AudioRecord, stream: FileOutputStream) {
+        runCatching { Process.setThreadPriority(Process.THREAD_PRIORITY_URGENT_AUDIO) }
+        val pcm = ByteArray(CHUNK_BYTES)
+        try {
+            while (!stopRequested.get()) {
+                var offset = 0
+                while (offset < pcm.size && !stopRequested.get()) {
+                    val read = sink.read(pcm, offset, pcm.size - offset, AudioRecord.READ_BLOCKING)
+                    if (read < 0) error("AudioRecord.read failed: $read")
+                    if (read > 0) offset += read
+                }
+                if (offset > 0) stream.write(pcm, 0, offset)
+            }
+        } catch (t: Throwable) {
+            if (!stopRequested.get()) {
+                AppLogger.i(TAG, "PCM consumer disconnected or stream ended: ${t.message}")
+            }
+        } finally {
+            stopRequested.set(true)
+            closeResources()
+            onEnded(this)
+        }
+    }
+
+    override fun stop() {
+        if (!stopRequested.compareAndSet(false, true)) return
+        runCatching { record?.stop() }
+        if (Thread.currentThread() !== thread) runCatching { thread?.join(STOP_JOIN_MS) }
+        closeResources()
+    }
+
+    @Synchronized
+    private fun closeResources() {
+        runCatching { record?.stop() }
+        runCatching { record?.release() }
+        runCatching { output?.close() }
+        runCatching { outFd.close() }
+        record = null
+        output = null
+    }
+
+    companion object {
+        private const val TAG = "CV:FarPcm"
+        private const val CHUNK_FRAMES = 960 // 20 ms at 48 kHz
+        private const val CHUNK_BYTES = CHUNK_FRAMES * 2
+        private const val STOP_JOIN_MS = 1_000L
+    }
+}
diff --git a/b4a/FarPartyPcmReceiver.bas b/b4a/FarPartyPcmReceiver.bas
new file mode 100644
index 0000000..e02112a
--- /dev/null
+++ b/b4a/FarPartyPcmReceiver.bas
@@ -0,0 +1,68 @@
+'Class module: FarPartyPcmReceiver
+'Requires the JavaObject and RandomAccessFile libraries.
+Sub Class_Globals
+    Private mCallBack As Object
+    Private mEventName As String
+    Private PcmAStream As AsyncStreams
+    Private PcmPfd As JavaObject
+End Sub
+
+Public Sub Initialize(CallBack As Object, EventName As String)
+    mCallBack = CallBack
+    mEventName = EventName
+End Sub
+
+'Call only after the WhatsApp call is answered.
+Public Sub Start
+    If PcmAStream.IsInitialized Then Return
+
+    Dim ctxt As JavaObject
+    ctxt.InitializeContext
+    Dim resolver As JavaObject = ctxt.RunMethod("getContentResolver", Null)
+
+    Dim uriClass As JavaObject
+    uriClass.InitializeStatic("android.net.Uri")
+    Dim uri As Object = uriClass.RunMethod("parse", Array( _
+        "content://com.sara.voicecapturehelper.recorder/far-party-pcm"))
+
+    PcmPfd = resolver.RunMethod("openFileDescriptor", Array(uri, "r"))
+    Dim fd As Object = PcmPfd.RunMethod("getFileDescriptor", Null)
+    Dim input As JavaObject
+    input.InitializeNewInstance("java.io.FileInputStream", Array(fd))
+    PcmAStream.Initialize(input, Null, "Pcm")
+End Sub
+
+Private Sub Pcm_NewData(Buffer() As Byte)
+    'AsyncStreams owns/reuses its input handling; hand the event a private copy.
+    Dim Copy(Buffer.Length) As Byte
+    Bit.ArrayCopy(Buffer, 0, Copy, 0, Buffer.Length)
+    CallSubDelayed2(mCallBack, mEventName & "_Pcm", Copy)
+End Sub
+
+Private Sub Pcm_Error
+    Stop
+    CallSubDelayed2(mCallBack, mEventName & "_Error", LastException.Message)
+End Sub
+
+Private Sub Pcm_Terminated
+    Stop
+    CallSubDelayed(mCallBack, mEventName & "_Closed")
+End Sub
+
+Public Sub Stop
+    If PcmAStream.IsInitialized Then PcmAStream.Close
+    If PcmPfd.IsInitialized Then PcmPfd.RunMethod("close", Null)
+End Sub
+
+'Stream format constants.
+Public Sub SampleRate As Int
+    Return 48000
+End Sub
+
+Public Sub Channels As Int
+    Return 1
+End Sub
+
+Public Sub BitsPerSample As Int
+    Return 16
+End Sub
